<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:viewmodels="clr-namespace:Packo.ViewModels"
             x:DataType="viewmodels:DocsViewModel"
             x:Class="Packo.Views.DocsPage"
             xmlns:local="clr-namespace:Packo.Models.Pages"
             Title="{Binding Title}">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height ="*"/>
            <RowDefinition Height ="Auto"/>
        </Grid.RowDefinitions>

        <CollectionView ItemsSource="{Binding Docs}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="TripDocument">
                    <Grid Padding="10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDocumentCommand}"
                        CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <Label Grid.Column="0" Text="{Binding FileName}" VerticalOptions="Center" />

                        <Button
                        Grid.Column="1"
                        Text="🗑"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteDocumentCommand}"
                        CommandParameter="{Binding .}" />

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" BackgroundColor="#4285F4" Margin="10" HorizontalOptions="Fill" Text="+" FontSize="Title" Padding="0" Command="{Binding AddDocumentCommand}" />
    </Grid>


</local:BasePage>
