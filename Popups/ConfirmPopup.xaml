<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:TypeArguments="x:Boolean"
    x:Class="PackMeUp.Popups.ConfirmPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
   CanBeDismissedByTappingOutsideOfPopup="False">

	<toolkit:Popup.Resources>
		<ResourceDictionary>
			<Style TargetType="Border">
				<Setter Property="Stroke" Value="Transparent" />
				<Setter Property="StrokeThickness" Value="0" />
              <Setter Property="Background" Value="Transparent" />
				<Setter Property="Shadow" Value="{x:Null}" />
				<Setter Property="Margin" Value="0" />
				<Setter Property="Padding" Value="0" />
			</Style>
		</ResourceDictionary>
	</toolkit:Popup.Resources>

	<Border
        Stroke="Transparent"
        StrokeThickness="0"
        Background="Transparent"
		Shadow="{x:Null}"
        StrokeShape="RoundRectangle 20">

		<VerticalStackLayout Padding="20" Margin="0" Spacing="15" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

			<Label
				x:Name="TitleLabel"
				Text="Confirm"
				FontSize="18"
				FontAttributes="Bold"
				HorizontalOptions="Center" />

			<Label
				x:Name="MessageLabel"
				Text="Are you sure?"
				HorizontalOptions="Center"
				HorizontalTextAlignment="Center" />

			<HorizontalStackLayout Spacing="10" HorizontalOptions="Center">

				<Button Text="No" Clicked="OnCancelClicked" />

				<Button Text="Yes" Clicked="OnConfirmClicked" />

			</HorizontalStackLayout>

		</VerticalStackLayout>
	</Border>
</toolkit:Popup>
