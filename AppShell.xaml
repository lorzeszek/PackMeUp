<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Packo.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Packo.Views"
    FlyoutBehavior="Disabled"
    Title="Packo"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}"
    Shell.TabBarTitleColor="Red"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light=#888888, Dark=#888888}">

    <Shell.TitleView>
        <views:ShellHeaderView />
    </Shell.TitleView>

    <TabBar>
        <ShellContent
            Title="Home"
            Icon="home.png"
            Route="Home"
            ContentTemplate="{DataTemplate views:StartPage}" />

        <ShellContent
            Title="Trips"
            Icon="travel_bag.png"
            Route="TripList"
            ContentTemplate="{DataTemplate views:TripListPage}" />

        <ShellContent
            Title="Weather"
            Icon="cloudy.png"
            Route="Weather"
            ContentTemplate="{DataTemplate views:WeatherPage}" />

        <ShellContent
            Title="Docs"
            Icon="archive.png"
            Route="Docs"
            ContentTemplate="{DataTemplate views:DocsPage}" />

        <ShellContent
            Title="Settings"
            Icon="settings.png"
            Route="Settings"
            ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>

</Shell>
