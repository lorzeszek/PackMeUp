<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Brand / accent colors (used across styles via AppThemeBinding) -->
    <Color x:Key="Primary">#FED0BA</Color>
    <Color x:Key="PrimaryDark">#D8C3A5</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#FDF6DA</Color>
    <Color x:Key="SecondaryDarkText">#FED0BA</Color>
    <Color x:Key="Tertiary">#A3B18A</Color>

    <!-- Base colors -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="OffBlack">#121212</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="Magenta">#D600AA</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- Semantic colors (recommended for views; keep raw palette above for styles) -->
    <!-- Light theme colors -->
    <Color x:Key="PageBackgroundLight">#FFFFFF</Color>
    <Color x:Key="PageTextLight">#1B1B1B</Color>
    <Color x:Key="SurfaceLight">#F6F6F6</Color>
    <Color x:Key="SurfaceTextLight">#1B1B1B</Color>
    <Color x:Key="BorderLight">#E1E1E1</Color>
    <Color x:Key="OverlayLight">#80000000</Color>

    <!-- Dark theme colors -->
    <Color x:Key="PageBackgroundDark">#121212</Color>
    <Color x:Key="PageTextDark">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1E1E1E</Color>
    <Color x:Key="SurfaceTextDark">#FFFFFF</Color>
    <Color x:Key="BorderDark">#404040</Color>
    <Color x:Key="OverlayDark">#80000000</Color>

    <!-- Semantic dynamic brushes (use these in pages instead of hardcoding) -->
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"/>
    <SolidColorBrush x:Key="PageTextBrush" Color="{AppThemeBinding Light={StaticResource PageTextLight}, Dark={StaticResource PageTextDark}}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"/>
    <SolidColorBrush x:Key="SurfaceTextBrush" Color="{AppThemeBinding Light={StaticResource SurfaceTextLight}, Dark={StaticResource SurfaceTextDark}}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="{AppThemeBinding Light={StaticResource OverlayLight}, Dark={StaticResource OverlayDark}}"/>

    <!-- Keep color aliases where a Color value (not Brush) is required -->
    <Color x:Key="BorderColor">#E1E1E1</Color>
    <Color x:Key="OverlayColor">#80000000</Color>

    <!-- Cards (keep compatibility with any existing usage) -->
    <Color x:Key="CardBackgroundColor">#F6F6F6</Color>
    <Color x:Key="CardTextColor">#1B1B1B</Color>
    <Color x:Key="CardBackgroundColorDark">#1E1E1E</Color>
    <Color x:Key="CardTextColorDark">#FFFFFF</Color>
</ResourceDictionary>